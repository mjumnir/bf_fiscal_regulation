<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_bf_regime_impot_tree" model="ir.ui.view">
        <field name="name">bf.regime.impot.tree</field>
        <field name="model">bf.regime.impot</field>
        <field name="arch" type="xml">
            <tree string="Régimes d'imposition" editable="bottom">
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="view_bf_regime_impot_form" model="ir.ui.view">
        <field name="name">bf.regime.impot.form</field>
        <field name="model">bf.regime.impot</field>
        <field name="arch" type="xml">
            <form string="Régime d'imposition">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bf_regime_impot" model="ir.actions.act_window">
        <field name="name">Régimes d'imposition</field>
        <field name="res_model">bf.regime.impot</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_bf_regime_impot"
              name="Régimes d'imposition (BF)"
              parent="account.menu_finance_configuration"
              action="action_bf_regime_impot"
              sequence="90"/>

</odoo>
